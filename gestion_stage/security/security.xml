<?xml version="1.0"?>
<odoo>
    <!-- Définition de la catégorie du module -->
    <record id="module_gestion" model="ir.module.category">
        <field name="name">Gestion</field>
    </record>

    <!-- Groupe Étudiant -->
    <record id="gestion_stage.group_etudiant" model="res.groups">
        <field name="name">Étudiant</field>
        <field name="category_id" ref="module_gestion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Groupe Encadrant -->
    <record id="gestion_stage.group_encadrant" model="res.groups">
        <field name="name">Encadrant</field>
        <field name="category_id" ref="module_gestion"/>
        <!-- L'encadrant hérite des droits du groupe Étudiant -->
        <field name="implied_ids" eval="[(4, ref('gestion_stage.group_etudiant'))]"/>

    </record>

    <!-- Groupe Administrateur de stage -->
    <record id="gestion_stage.group_admin_stage" model="res.groups">
        <field name="name">Administrateur des stages</field>
        <field name="category_id" ref="module_gestion"/>
        <!-- L'administrateur hérite des droits du groupe Encadrant -->
        <field name="implied_ids" eval="[(4, ref('gestion_stage.group_encadrant'))]"/>
        <!-- On peut lier ici des utilisateurs spécifiques (facultatif) -->
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

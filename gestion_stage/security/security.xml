<?xml version="1.0"?>
<odoo>
    <!-- Définition de la catégorie du module -->
    <record id="module_gestion" model="ir.module.category">
        <field name="name">Gestion</field>
    </record>

    <!-- Groupe Étudiant -->
    <record id="gestion_stage.group_etudiant" model="res.groups">
        <field name="name">Étudiant</field>
        <field name="category_id" ref="module_gestion"/>
        <!-- Vous pouvez inclure des implied_ids si nécessaire -->
    </record>

    <!-- Groupe Encadrant -->
    <record id="gestion_stage.group_encadrant" model="res.groups">
        <field name="name">Encadrant</field>
        <field name="category_id" ref="module_gestion"/>
        <!-- Vous pouvez inclure des implied_ids si nécessaire -->
    </record>

    <!-- Groupe Administrateur de stage -->
    <record id="gestion_stage.group_admin_stage" model="res.groups">
        <field name="name">Administrateur des stages</field>
        <field name="category_id" ref="module_gestion"/>
        <!-- Vous pouvez lier ce groupe aux utilisateurs administrateurs de base si besoin -->
    </record>
</odoo>

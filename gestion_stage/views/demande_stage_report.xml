<odoo>
    <data>

        <!-- Définir le template du rapport -->
        <template id="report_demande_stage">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2>Rapport des Demandes de Stage</h2>

                    <!-- Statistiques par statut -->
                    <div>
                        <h3>Statistiques par statut</h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Statut</th>
                                    <th>Nombre de demandes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>À soumettre</td>
                                    <td><t t-esc="docs.filtered(lambda d: d.statut == 'à soumettre').__len__()"/></td>
                                </tr>
                                <tr>
                                    <td>En attente</td>
                                    <td><t t-esc="docs.filtered(lambda d: d.statut == 'en attente').__len__()"/></td>
                                </tr>
                                <tr>
                                    <td>Approuvée</td>
                                    <td><t t-esc="docs.filtered(lambda d: d.statut == 'approuvée').__len__()"/></td>
                                </tr>
                                <tr>
                                    <td>Rejetée</td>
                                    <td><t t-esc="docs.filtered(lambda d: d.statut == 'rejetée').__len__()"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Liste des demandes de stage -->
                    <h3>Liste des Demandes de Stage</h3>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Nom de l'Étudiant</th>
                                <th>Entreprise</th>
                                <th>Responsable</th>
                                <th>Date de Début</th>
                                <th>Date de Fin</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="doc">
                                <td><t t-esc="doc.etudiant_id.name"/></td>
                                <td><t t-esc="doc.entreprise_nom"/></td>
                                <td><t t-esc="doc.responsable"/></td>
                                <td><t t-esc="doc.date_debut"/></td>
                                <td><t t-esc="doc.date_fin"/></td>
                                <td><t t-esc="doc.statut"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </template>

    </data>
</odoo>

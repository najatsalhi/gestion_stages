<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demande_stage_tree" model="ir.ui.view">
        <field name="name">demande_stage.list</field>
        <field name="model">gestion_stage.demande_stage</field>
        <field name="arch" type="xml">
            <list string="Demandes de Stage">
                <field name="etudiant_id"/>
                <field name="entreprise_nom"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="statut"/>
            </list>
        </field>
    </record>

    <record id="view_demande_stage_form" model="ir.ui.view">
        <field name="name">demande_stage.form</field>
        <field name="model">gestion_stage.demande_stage</field>
        <field name="arch" type="xml">
            <form string="Demande de Stage">
                <sheet>
                    <group>
                        <field name="etudiant_id"/>
                        <field name="entreprise_nom"/>
                        <field name="entreprise_adresse"/>
                        <field name="responsable"/>
                    </group>
                    <group>
                        <field name="date_debut"/>
                        <field name="date_fin"/>
                        <field name="statut"/>
                    </group>
                </sheet>
            </form>
        </field>
   </record>
</odoo>
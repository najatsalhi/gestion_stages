<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_convention_stage_list" model="ir.ui.view">
        <field name="name">convention_stage.list</field>
        <field name="model">gestion_stage.convention_stage</field>
        <field name="arch" type="xml">
            <list string="Conventions de Stage">
                <field name="demande_stage_id"/>
                <field name="valide_encadrant"/>
                <field name="valide_admin"/>
            </list>
        </field>
    </record>

    <record id="view_convention_stage_form" model="ir.ui.view">
        <field name="name">convention_stage.form</field>
        <field name="model">gestion_stage.convention_stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                         <field name="demande_stage_id"/>
                        <field name="fichier_convention" widget="binary"/>
                        <field name="valide_encadrant"/>
                        <field name="valide_admin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
